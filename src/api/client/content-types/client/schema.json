// api/client/content-types/client/schema.json
{
  "kind": "collectionType",
  "collectionName": "clients",
  "info": {
    "singularName": "client",
    "pluralName": "clients",
    "displayName": "Client"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "company_name": {
      "type": "string",
      "required": true
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text"
    },
    "credit_approved": {
      "type": "boolean",
      "default": false
    },
    "credit_limit": {
      "type": "decimal",
      "default": 0
    },
    "payment_terms": {
      "type": "enumeration",
      "enum": ["cash", "credit_7", "credit_15", "credit_30", "pdc"],
      "default": "cash"
    },
    "adverts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::advert.advert",
      "mappedBy": "client"
    },
    "invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "client"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
