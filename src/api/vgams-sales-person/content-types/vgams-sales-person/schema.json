{
  "kind": "collectionType",
  "collectionName": "vgams_sales_persons",
  "info": {
    "singularName": "vgams-sales-person",
    "pluralName": "vgams-sales-persons",
    "displayName": "VGAMS Sales Persons"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "adverts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::advert.advert",
      "mappedBy": "vgams_sales_persons"
    }
  }
}
