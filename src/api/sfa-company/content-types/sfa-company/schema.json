{
  "kind": "collectionType",
  "collectionName": "sfa_companies",
  "info": {
    "singularName": "sfa-company",
    "pluralName": "sfa-companies",
    "displayName": "SFA Prospect Company"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "company_name": { "type": "string", "required": true },
    "contact_person": { "type": "string" },
    "email": { "type": "email" },
    "phone": { "type": "string" },
    "address": { "type": "text" },
    "industry": { "type": "string" },
    "location": { "type": "string" },
    "contacts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sfa-contact.sfa-contact",
      "mappedBy": "company"
    },
    "opportunities": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sfa-opportunity.sfa-opportunity",
      "mappedBy": "company"
    }
  }
}
