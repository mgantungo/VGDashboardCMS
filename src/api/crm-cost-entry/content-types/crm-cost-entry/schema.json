{
  "kind": "collectionType",
  "collectionName": "crm_cost_entries",
  "info": {
    "singularName": "crm-cost-entry",
    "pluralName": "crm-cost-entries",
    "displayName": "CRM Cost Entry"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "workstream": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::crm-workstream.crm-workstream",
      "inversedBy": "cost_entries"
    },
    "amount": {
      "type": "biginteger",
      "default": "0"
    },
    "cost_type": {
      "type": "enumeration",
      "enum": [
        "internal",
        "third_party",
        "other"
      ],
      "default": "internal"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "committed",
        "actual"
      ],
      "default": "actual"
    },
    "incurred_on": {
      "type": "date"
    },
    "source_ref": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "procurement_order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::crm-procurement-order.crm-procurement-order"
    },
    "entered_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::crm-profile.crm-profile"
    }
  }
}
