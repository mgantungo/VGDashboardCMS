{
  "kind": "collectionType",
  "collectionName": "sfa_units",
  "info": {
    "singularName": "sfa-unit",
    "pluralName": "sfa-units",
    "displayName": "SFA Unit"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "code": {
      "type": "string",
      "unique": true
    },
    "supervisor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "agents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user"
    },
    "agent_profiles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sfa-agent-profile.sfa-agent-profile",
      "mappedBy": "unit"
    }
  }
}
