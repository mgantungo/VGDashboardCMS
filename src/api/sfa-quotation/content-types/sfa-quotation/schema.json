{
  "kind": "collectionType",
  "collectionName": "sfa_quotations",
  "info": {
    "singularName": "sfa-quotation",
    "pluralName": "sfa-quotations",
    "displayName": "SFA Quotation"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "quotation_number": {
      "type": "string",
      "unique": true,
      "description": "Auto-generated: QT-YYYYMM-XXXX"
    },
    "opportunity": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sfa-opportunity.sfa-opportunity",
      "inversedBy": "quotations"
    },
    "version": { "type": "integer", "default": 1, "required": true },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "pending_approval", "approved", "sent_to_client", "revised", "rejected", "accepted"],
      "default": "draft",
      "required": true
    },
    "total_amount": { "type": "decimal", "default": 0 },
    "notes": { "type": "text" },
    "submitted_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sfa-agent-profile.sfa-agent-profile",
      "description": "The agent who created / submitted this quotation."
    },
    "reviewed_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sfa-agent-profile.sfa-agent-profile",
      "description": "The supervisor or manager who approved or rejected."
    },
    "reviewed_at": { "type": "datetime" },
    "review_comment": { "type": "text" },
    "pdf_document": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "parent_quotation": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sfa-quotation.sfa-quotation",
      "description": "The previous version this was revised from."
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sfa-quotation-item.sfa-quotation-item",
      "mappedBy": "quotation"
    },
    "communications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sfa-quotation-communication.sfa-quotation-communication",
      "mappedBy": "quotation"
    }
  }
}
