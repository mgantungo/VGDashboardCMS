      "required": true
    },
    "display_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "avatar_url": {
      "type": "string"
    },
    "wp_id": {
      "type": "integer",
      "unique": true
    },
    "posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "inversedBy": "authors"
    }
  }
