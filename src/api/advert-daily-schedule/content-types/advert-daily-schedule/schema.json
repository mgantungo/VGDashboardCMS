{
  "kind": "collectionType",
  "collectionName": "advert_daily_schedules",
  "info": {
    "singularName": "advert-daily-schedule",
    "pluralName": "advert-daily-schedules",
    "displayName": "CIO Advert Daily Schedule"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "run_date": {
      "type": "date",
      "required": true
    },
    "run_time": {
      "type": "json"
    },
    "adverts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::advert.advert",
      "mappedBy": "advert_daily_schedules"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "page": {
      "type": "biginteger",
      "default": "0"
    },
    "source_batches": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::design-batch.design-batch",
      "mappedBy": "daily_schedules"
    }
  }
}
