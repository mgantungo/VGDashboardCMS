{
  "kind": "collectionType",
  "collectionName": "advert_daily_schedules",
  "info": {
    "singularName": "advert-daily-schedule",
    "pluralName": "advert-daily-schedules",
    "displayName": "CIO Advert Daily Schedule"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "run_date": {
      "type": "date",
      "required": true
    },
    "run_time": {
      "type": "json"
    },
    "adverts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::advert.advert",
      "mappedBy": "advert_daily_schedules"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "page": {
      "type": "biginteger",
      "default": "0"
    },
    "source_batches": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::design-batch.design-batch",
      "mappedBy": "daily_schedules"
    },
    "source_file_group_id": {
      "type": "integer",
      "description": "The design-batch file_group component's own id this schedule row was created for. Components aren't a standalone content-type in Strapi, so this is a plain integer reference rather than a relation. Null for schedule rows created outside design-batch (legacy direct scheduling) — those remain 'ungrouped' from the editor's perspective."
    },
    "carried_from": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::advert-daily-schedule.advert-daily-schedule"
    },
    "artwork_dropped": {
      "type": "boolean",
      "default": false
    },
    "artwork_dropped_reason": {
      "type": "text"
    }
  }
}