{
  "kind": "collectionType",
  "collectionName": "crm_recurring_rules",
  "info": {
    "singularName": "crm-recurring-rule",
    "pluralName": "crm-recurring-rules",
    "displayName": "CRM Recurring Rule"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "workstream": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::crm-workstream.crm-workstream"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "frequency": {
      "type": "enumeration",
      "enum": [
        "weekly",
        "monthly",
        "quarterly"
      ],
      "default": "monthly",
      "required": true
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "day_of_month": {
      "type": "integer",
      "default": 1
    },
    "assignee": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::crm-profile.crm-profile"
    },
    "last_generated_for": {
      "type": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
