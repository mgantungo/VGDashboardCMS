{
  "kind": "collectionType",
  "collectionName": "sfa_opportunity_buy_ins",
  "info": {
    "singularName": "sfa-opportunity-buy-in",
    "pluralName": "sfa-opportunity-buy-ins",
    "displayName": "SFA Opportunity Buy-In Line"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "opportunity": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sfa-opportunity.sfa-opportunity",
      "inversedBy": "buy_in_lines"
    },
    "buy_in": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sfa-buy-in.sfa-buy-in"
    },
    "quantity": { "type": "integer", "default": 1, "required": true },
    "unit_price": { "type": "decimal", "default": 0, "required": true },
    "subtotal": { "type": "decimal", "default": 0 },
    "notes": { "type": "text" },
    "custom_offer": { "type": "text" }
  }
}
